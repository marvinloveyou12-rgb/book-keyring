# 도서 API. 비워두면 설정된 것 중 우선순위대로 사용합니다: yes24 → aladin → kakao → google
# 강제로 하나만 쓰려면: yes24 | aladin | kakao | google | mock (오프라인 샘플)
BOOK_PROVIDER=

# YES24 제휴 API (공개 API 없음. 제휴 승인 후 src/lib/providers/yes24.ts 구현 필요)
YES24_API_URL=
YES24_API_KEY=

# 알라딘 TTB 키 — https://www.aladin.co.kr/ttb/wblog_manage.aspx
ALADIN_TTB_KEY=

# 카카오 REST API 키 — https://developers.kakao.com
KAKAO_REST_KEY=

# Google Books (키 없이도 동작, 할당량 낮음). 끄려면 GOOGLE_BOOKS_DISABLED=1
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_DISABLED=

# 이미지 프록시에 추가로 허용할 호스트 (쉼표 구분)
IMAGE_PROXY_EXTRA_HOSTS=
